{
  "name": "bot-associacao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit",
    "registrar": "tsx src/discord/registrar-comandos.ts",
    "db:test": "docker run --rm -d --name pg-bot-teste -e POSTGRES_PASSWORD=teste -p 54329:5432 postgres:17-alpine"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "discord.js": "^14.28.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^26.6.10",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
